{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-jewelry-form-builder",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/api/*", "/f/*", "/media/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "konfigurator", "database_id": "89e570b8-3540-4f5b-b76f-99a2f9f3c27a", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "konfigurator-media" }],
  // First render and refinement model keys (see MODELS in src/worker.js): flash, pro, gptflare, gptsun, gpt2
  "vars": { "FIRST_MODEL": "gptflare", "TWEAK_MODEL": "flash" }
}
